let T = type #a|#b|#c|#d

@test(#both, ((#a, #b), (#c, #d)))
@test(#up_fail, ((#a, #d), (#c, #b)))
with Seq(type (T, T), _)
def main() = seq {
    val((#a, #b))
    val((#c, #d))
}

@test(#both, ((a = #a, b = #b), (a = #c, b = #d)))
@test(#up_fail, ((a = #a, b = #d), (a = #c, b = #b)))
with Seq(type (a = T, b = T), _)
def main() = seq {
    val((a = #a, b = #b))
    val((a = #c, b = #d))
}
