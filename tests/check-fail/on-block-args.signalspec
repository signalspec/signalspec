@test(#up, ())
with Seq(type #x, _) def main() = new Seq(type #x, #up) {
//# too many positional arguments
    on val(x, y) {
//            ^ 1 unexpected positional arguments
        val(x)
        val(y)
    }

//# unexpected named argument `y`
    on val(x, y = #y) {
//            ^^^^^^ unexpected argument
        val(x)
    }

//# missing required argument `val`
    on val() {}
//         ^ expected an additional argument

}
